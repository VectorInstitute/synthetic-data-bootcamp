# Filing text is large (about 1.3 GB) and can be re-downloaded with src.download_10k.
# Metadata.json and download_status.csv are small and tracked, so the team can see
# exactly what was downloaded.
data/raw/**/10k.htm
data/raw/**/10k.txt
data/raw/**/ex13_*
data/raw/**/*.tmp
data/parsed/*
!data/parsed/.gitkeep
data/index.csv
# The root .gitignore ignores all CSVs, so re-include the small status files
!data/download_status.csv
!data/parse_status.csv

# Your real SEC identity (name and email) lives here, never in config.yaml
config.local.yaml

# Logs and local environment
logs/
.venv/
