# Filing text is large (about 1.3 GB) and can be re-downloaded with method_2.step01_download_10k.
# Metadata.json and download_status.csv are small and tracked, so the team can see
# exactly what was downloaded.
!data/parsed/.gitkeep
data/index.csv
# Companyfacts JSON is large (about 180 MB) and can be re-downloaded with
# method_2.step04_fetch_companyfacts. calibration.json, computed from it, is small and kept.
data/companyfacts/*.json
# The root .gitignore ignores all CSVs, so re-include the small status files and
# the frozen S&P 500 constituent snapshot used by method_2.step00_sample_companies
!data/download_status.csv
!data/parse_status.csv
!data/companyfacts_status.csv
!data/sp500_constituents.csv
!data/validation_report.csv
!data/qa_pairs.csv
!data/retrieval_eval.csv
!data/gap_report.csv
!data/privacy_report.csv

# Your real SEC identity (name and email) lives here, never in config.yaml
config.local.yaml

# Logs
logs/

# Cached embedding vectors from RAG.retrieval's hosted models; rebuilt on demand.
data/embedding_cache/

# Cached whole-corpus doc matrix for RAG.chatbot / RAG.chatbot_server (see
# RAG.retrieval's module docstring); regenerated automatically, content-hash checked.
data/semantic_embeddings_cache.npz
