# Optional local overrides for this implementation.
# Copy to `.env` only if you need them — the workshop environment usually
# already provides the Vector proxy baseline as process env vars
# (OPENAI_API_KEY + VECTOR_PROXY_BASE_URL). You are not given a Vector key
# to paste here for the default path.

# --- Optional: override the Vector baseline (normally already set in the env) ---
# OPENAI_API_KEY=
# VECTOR_PROXY_API_KEY=          # alias for the same baseline key
# VECTOR_PROXY_BASE_URL=https://proxy.vectorinstitute.ai/v1

# --- Optional per-role overrides (unset → baseline key + Vector base URL) ---
# Use these to point judge / VLM image edit at your own provider or model service.
# JUDGE_API_KEY=
# JUDGE_API_BASE_URL=
# VLM_API_KEY=
# VLM_API_BASE_URL=

# --- Optional: direct Google Gemini ---
# Only if you set generation.vlm_provider=gemini and clear vlm_api_base_url
# (not the default workshop path).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Hugging Face (gated Mapillary toy extract + some model weights) ---
# Notebook 0 can also prompt an interactive login if this is unset.
# Before first extract: open https://huggingface.co/datasets/candylion/mapillary-vistas-v2
# while logged in and accept / approve access once.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
