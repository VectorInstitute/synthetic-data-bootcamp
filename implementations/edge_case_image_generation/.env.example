# Workshop baseline — Vector Institute OpenAI-compatible proxy.
# Copy to `.env` in this folder and paste your real key.
OPENAI_API_KEY=vp_your_key_here
VECTOR_PROXY_BASE_URL=https://proxy.vectorinstitute.ai/v1

# Optional alias for the same baseline key:
# VECTOR_PROXY_API_KEY=

# Optional per-role overrides (unset → OPENAI_API_KEY + VECTOR_PROXY_BASE_URL):
# JUDGE_API_KEY=
# JUDGE_API_BASE_URL=
# VLM_API_KEY=
# VLM_API_BASE_URL=

# Optional: direct Google Gemini (only if you set generation.vlm_provider=gemini
# and clear vlm_api_base_url — not the default workshop path).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Hugging Face (gated Mapillary toy extract + some model weights).
# Notebook 0 can also prompt an interactive login if this is unset.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
