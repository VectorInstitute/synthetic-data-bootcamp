# Copy to terraform.tfvars and fill in real values. Do not commit terraform.tfvars.
#
# Coder auto-loads this file when you run (from this directory):
#   coder templates push <template-name>

project               = "pets-3-bootcamp" # GCP project id
region                = "us-central1"
zone                  = "us-central1-a"
github_repo           = "https://github.com/VectorInstitute/synthetic-data-bootcamp.git"
github_branch         = "main"
github_app_id         = "primary-github" # shared Coder on platform.vectorinstitute.ai
service_account_email = "pet-3-coder-sa@pets-3-bootcamp.iam.gserviceaccount.com"
jupyterlab            = "true"
codeserver            = "true"
streamlit             = "true"
token_service_url     = "https://your-token-service.run.app"
bootcamp_name         = "pets-3-bootcamp"
firebase_api_key      = "your-firebase-web-api-key"
