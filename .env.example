# Strong model used for synthetic data generation (teacher / distillation)
***REMOVED***<your_openai_api_key>
TEACHER_MODEL=gemini-3.5-flash
OPENAI_BASE_URL=https://proxy.vectorinstitute.ai/v1

# Model used for LLM-as-judge evaluation
JUDGE_MODEL=gemini-3.5-flash

# Small model (local Qwen via Ollama — defaults match Docker / GCP setup)
SMALL_MODEL_API_KEY=ollama
SMALL_MODEL_NAME=qwen2.5:3b-instruct
SMALL_MODEL_BASE_URL=http://127.0.0.1:11434/v1

# Ollama settings (used by scripts/start-ollama.sh in Docker)
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_HOST=127.0.0.1:11434
# SKIP_OLLAMA=0
# SKIP_OLLAMA_PULL=0

# Set to 1 to run GPU LoRA fine-tuning in notebook 05 (needs CUDA; not via Ollama)
RUN_SFT=0
SFT_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
