# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Lint & Test
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Vscode
.vscode

# macos
*.DS_Store

# ipynb checkpoints
**.ipynb_checkpoints

.env
.terraform

# QA text generation — generated artifacts (sample source excerpts in documents/*.txt are kept)
implementations/qa_text_generation/data/paragraphs.jsonl
implementations/qa_text_generation/data/results/*
!implementations/qa_text_generation/data/results/.gitkeep
implementations/qa_text_generation/data/synthetic/*
!implementations/qa_text_generation/data/synthetic/.gitkeep
implementations/qa_text_generation/data/test/*
!implementations/qa_text_generation/data/test/.gitkeep
implementations/qa_text_generation/data/documents/*
!implementations/qa_text_generation/data/documents/*.txt
implementations/qa_text_generation/models/*
!implementations/qa_text_generation/models/.gitkeep

# Edge-case image generation: local artifacts / downloaded weights
# Prefer /* so .gitkeep placeholders can still be tracked.
implementations/edge_case_image_generation/outputs/*
!implementations/edge_case_image_generation/outputs/.gitkeep
implementations/edge_case_image_generation/runs/
implementations/edge_case_image_generation/weights/*
!implementations/edge_case_image_generation/weights/.gitkeep
implementations/edge_case_image_generation/.venv/
implementations/edge_case_image_generation/.env
implementations/edge_case_image_generation/.cache/
*.pt
*.pth
*.bin
*.ckpt
*.onnx
*.safetensors
*.engine
